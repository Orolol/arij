{
  "name": "arij",
  "version": "0.1.0",
  "private": true,
  "description": "A local, AI-first project orchestrator with a web interface for managing multi-project workflows with Claude Code as the execution engine.",
  "author": "Gaetan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orolol/arij.git"
  },
  "keywords": [
    "ai",
    "project-management",
    "claude-code",
    "local-first",
    "orchestrator",
    "Next.js"
  ],
  "bin": {
    "arij": "./bin/arij.mjs"
  },
  "scripts": {
    "dev": "node ./bin/arij.mjs dev",
    "build": "next build",
    "start": "node ./bin/arij.mjs start",
    "lint": "eslint",
    "test": "vitest run",
    "test:changed": "vitest run --changed main",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "i18n:index": "node scripts/i18n/build-messages-index.mjs",
    "i18n:check": "node scripts/i18n/build-messages-index.mjs --check && node scripts/i18n/check-keys.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@octokit/rest": "^22.0.1",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.563.0",
    "mammoth": "^1.11.0",
    "nanoid": "^5.1.6",
    "next": "16.3.3",
    "next-intl": "^4.14.2",
    "next-themes": "^0.4.6",
    "pdf-parse": "^2.4.5",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "simple-git": "^3.30.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "jsdom": "^25.0.1",
    "shadcn": "^3.8.4",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  }
}
